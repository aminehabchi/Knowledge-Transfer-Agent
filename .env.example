# Copy to .env and adjust. Placeholders only - never commit real secrets.
# The defaults below run the fully local DEMO mode (synthetic users, mock SharePoint, extractive assistant).

NODE_ENV=development            # development | test | production
HOST=127.0.0.1
PORT=3001
PUBLIC_BASE_URL=http://localhost:5173
DATABASE_PATH=./data/kta.db     # SQLite file (relative to server/)
LOG_LEVEL=info                  # fatal | error | warn | info | debug | trace | silent
# WEB_DIST_DIR=../web/dist      # serve the built SPA from the API server (production / Docker)

# --- Authentication -----------------------------------------------------------
AUTH_MODE=demo                  # demo (synthetic persona picker; refused in production) | entra
SESSION_TTL_HOURS=10
# Required when AUTH_MODE=entra (see docs/MICROSOFT365_SETUP.md)
ENTRA_TENANT_ID=<tenant-guid>
ENTRA_CLIENT_ID=<web-app-client-id>
ENTRA_CLIENT_SECRET=<stored-in-your-secret-manager>
ENTRA_REDIRECT_URI=https://kta.example.com/api/auth/callback
ENTRA_AUTO_PROVISION=false      # true = create a role-less user on first sign-in

# --- SharePoint (Microsoft Graph) ----------------------------------------------
SHAREPOINT_MODE=mock            # mock (SIMULATED; refused in production) | graph
GRAPH_TENANT_ID=<tenant-guid>
GRAPH_CLIENT_ID=<graph-app-client-id>
GRAPH_CLIENT_SECRET=<stored-in-your-secret-manager>
SHAREPOINT_SITE_ID=<contoso.sharepoint.com,site-guid,web-guid>
SHAREPOINT_DRIVE_ID=<document-library-drive-id>
SHAREPOINT_ROOT_FOLDER=KnowledgeTransfer
SHAREPOINT_SET_METADATA=true    # write Kta* list columns on uploaded handovers

# --- Assistant ------------------------------------------------------------------
LLM_PROVIDER=extractive         # extractive (local, non-generative) | anthropic
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium         # low | medium | high | xhigh | max
# ANTHROPIC_API_KEY=<stored-in-your-secret-manager>   # read by the Anthropic SDK

# --- Operations -----------------------------------------------------------------
JOB_POLL_INTERVAL_MS=2000
ASSISTANT_RATE_LIMIT_PER_MINUTE=20
DOCUMENT_STALE_AFTER_DAYS=365
