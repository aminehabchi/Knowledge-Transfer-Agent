{
  "name": "@kta/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../.env src/main.ts",
    "start": "node --env-file-if-exists=../.env src/main.ts",
    "seed": "node --env-file-if-exists=../.env src/scripts/seed.ts",
    "migrate": "node --env-file-if-exists=../.env src/scripts/migrate.ts",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@fastify/cookie": "^11.1.5",
    "fastify": "^5.12.7",
    "jose": "^6.2.14",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  }
}
